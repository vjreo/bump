# Invite gate — SHA-256 hex of the lowercase invite code (e.g. bump-xxxx)
# Generate: printf '%s' 'bump-xxxx' | openssl dgst -sha256
# Plaintext invite lives in INVITE.txt (gitignored) — do not commit it.
VITE_INVITE_HASH=

