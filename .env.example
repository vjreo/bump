# Invite gate — SHA-256 hex of the lowercase invite code (e.g. bump-xxxx)
# Generate: printf '%s' 'bump-xxxx' | openssl dgst -sha256
# Plaintext invite lives in INVITE.txt (gitignored) — do not commit it.
VITE_INVITE_HASH=

# Google Calendar — OAuth 2.0 *web* client ID (public by design), e.g. 1234-abc.apps.googleusercontent.com
# Leave empty until it exists; the Appts tab then shows "Calendar not set up yet".
VITE_GOOGLE_CLIENT_ID=
